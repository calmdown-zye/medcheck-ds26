# 비워 두면 프로젝트 내부 models/Qwen2.5-3B-Instruct를 사용합니다.
LOCAL_LLM_MODEL=models/Qwen2.5-3B-Instruct

# 선택 사항: PEFT/LoRA 어댑터 디렉터리. 베이스 모델만 사용할 때는 비워 둡니다.
LOCAL_LLM_ADAPTER=

# auto는 CUDA, Apple MPS, CPU 순서로 사용 가능한 장치를 선택합니다.
MEDCHECK_DEVICE=auto

LOCAL_LLM_MAX_INPUT_TOKENS=8192
LOCAL_LLM_MAX_NEW_TOKENS=1536
LOCAL_LLM_TRUST_REMOTE_CODE=0

MEDCHECK_INDEX_DIR=artifacts/medical_index
MEDCHECK_EMBEDDING_MODEL=models/multilingual-e5-small
MEDCHECK_TOP_K=3
MEDCHECK_DENSE_WEIGHT=0.65
MEDCHECK_BM25_WEIGHT=0.35

# 1이면 Hugging Face 캐시에 없는 임베딩 모델을 네트워크에서 받지 않습니다.
MEDCHECK_OFFLINE=0

# 문제 조사 때만 사용합니다.
MEDCHECK_PRINT_DEBUG=0
MEDCHECK_PRINT_RAW_OUTPUT=0
MEDCHECK_DEBUG_DIR=logs/invalid_json
